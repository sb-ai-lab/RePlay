[build-system]
requires = ["uv_build>=0.12.3,<1"]
build-backend = "uv_build"

[dependency-groups]
conditional = [
    "fixed-install-nmslib",
    "hnswlib",
    "lightfm; python_version < '3.13'",
    "onnx",
    "onnxscript",
    "openvino",
    "optuna",
]
dev = [
    { include-group = "docs" },
    { include-group = "style" },
    { include-group = "tests" },
]
docs = [
    "enum-tools[sphinx] (>=0.13.0,<0.14)",
    "sphinx >=8.1.3,<8.2",
    "sphinx-rtd-theme>=3.0.1,<3.1.0",
    "sphinx-autodoc-typehints (>=3.0.0)",
    "myst-parser",
    "ghp-import (==2.1.0)",
    "docutils (>=0.20.0)",
]
style = [
    "ruff (>=0.11.0,<1)",
    "toml-sort (>=0.23, <0.24)",
]
tests = [
    "coverage-conditional-plugin (>=0.9, <1)",
    "data-science-types (==0.2.23)",
    "filelock (>=3.14, <4)",
    "hypothesis",
    "implicit (>=0.7.2,<0.8)",
    "pyarrow-stubs",
    "pytest (>=9.0.0)",
    "pytest-mock (>3.15, <4.0)",
    "pytest-cov (>=3.0)",
{% if project == "experimental" %}
    "statsmodels (>=0.14,<0.16); python_version < '3.13'",
    "statsmodels (>=0.14.6,<0.16); python_version >= '3.13'",
{% endif %}
{% if project == "default" %}
    "statsmodels (>=0.14.6,<0.16)",
{% endif %}
]

[project]
name = "replay-rec"
version = "0.23.0"
license = "Apache-2.0"
description = "RecSys Library"
authors = [
    { name = "AI Lab" },
    { name = "Alexey Vasilev" },
    { name = "Anna Volodkevich" },
    { name = "Alexey Grishanov" },
    { name = "Yan-Martin Tamm" },
    { name = "Boris Shminke" },
    { name = "Alexander Sidorenko" },
    { name = "Roza Aysina" },
]
readme = "README.md"
classifiers = [
    "Operating System :: Unix",
    "Development Status :: 4 - Beta",
    "Environment :: Console",
    "Intended Audience :: Developers",
    "Intended Audience :: Science/Research",
    "Natural Language :: English",
    "Topic :: Scientific/Engineering :: Artificial Intelligence",
]
requires-python = ">=3.10, <3.15"
dependencies = [
    "setuptools",
    "numpy (>=1.20.0,<2.5.0)",
    "pandas (>=1.3.5,<3)",
    "polars (>=1.0.0, <2)",
    "scipy (>=1.8.1,<2)",
    "scikit-learn (>=1.6.1,<1.9.0)",
    "pyarrow (<24)",
    "tqdm (>=4.67,<5)",
    "typing-extensions (>=4.12.0,<5)",
{% if project == "experimental" %}
    "ipython (>=8.0,<10)",
    "torch (>=1.8,<3.0.0)",
    "lightning (<3.0.0)",
    "pytorch-optimizer (>=3.8.0,<4)",
    "numba (>=0.50,<1)",
    "pyspark (>=3.0,<4); python_version < '3.13'",
    "pyspark (>=4.0,<4.1); python_version >= '3.13'",
    "psutil (<8)",
    "d3rlpy (>=2.8.1,<3)",
    "lightautoml (>=0.4.1,<0.5); python_version < '3.13'",
    "sb-obp (>=0.5.10,<0.6); python_version < '3.13'",
{% endif %}
]

{% if project == "default" %}
[project.optional-dependencies]
spark = [
    "psutil (<8)",
    "pyspark (>=3.0,<4); python_version < '3.13'",
    "pyspark (>=4.0,<4.1); python_version >= '3.13'",
]
torch = [
    "lightning (<3.0.0)",
    "pytorch-optimizer (>=3.8.0,<4)",
    "torch (>=1.8,<3.0.0)",
]
torch-cpu = [
    "lightning (<3.0.0)",
    "pytorch-optimizer (>=3.8.0,<4)",
    "torch (>=1.8,<3.0.0)",
]

{% endif %}
[project.urls]
homepage = "https://sb-ai-lab.github.io/RePlay/"
repository = "https://github.com/sb-ai-lab/RePlay"

[tool.coverage.coverage_conditional_plugin.rules]
py-lt-311 = "sys_version_info < (3, 11)"
py-lt-313 = "sys_version_info < (3, 13)"
py-lt-314 = "sys_version_info < (3, 14)"

[tool.coverage.run]
plugins = ["coverage_conditional_plugin"]
omit = [
    "replay/models/extensions/ann/index_stores/hdfs_index_store.py",
    "replay/experimental/*",
]

[tool.pytest]
doctest_optionflags = ["NORMALIZE_WHITESPACE"]
addopts = [
    "--cov=replay",
    "--cov-report=term-missing",
    "--cov-config=pyproject.toml",
    "--doctest-modules",
    "--junitxml=report.xml",
    "--cov-report=xml",
    "--durations=0",
]
testpaths = [
    "replay/",
    "tests/",
]
markers = [
    "experimental: tests that requires experimental part of the library",
    "core: tests that not requires additional dependencies",
    "spark: tests that requires Spark",
    "torch: tests that requires PyTorch",
    "conditional: test that utilize conditional imports",
]

[tool.ruff]
exclude = [".git", ".venv", "__pycache__", "env", "venv", "docs", "projects", "examples"]
line-length = 120
target-version = "py310"

[tool.ruff.lint]
select = ["ARG", "C4", "E", "EM", "F", "FLY", "I", "INP", "ISC", "N", "PERF", "PGH", "PIE", "PYI", "Q", "RUF", "SIM", "TID", "W"]
extend-select = ["C90", "T10", "T20", "UP004"]
ignore = ["SIM115"]
mccabe = { max-complexity = 13 }
isort = { combine-as-imports = true, force-wrap-aliases = true }

[tool.ruff.lint.flake8-quotes]
docstring-quotes = "double"
inline-quotes = "double"
multiline-quotes = "double"

[tool.ruff.lint.flake8-unused-arguments]
ignore-variadic-names = false

[tool.ruff.lint.per-file-ignores]
"*/" = ["PERF203", "RUF001", "RUF002", "RUF012", "E402"]
"__init__.py" = ["F401"]
"replay/utils/model_handler.py" = ["F403", "F405"]
"tests/*" = ["ARG", "E402", "INP", "ISC", "N", "S", "SIM", "F811"]
"tests/experimental/*" = ["F401", "F811"]
"replay/experimental/models/extensions/spark_custom_models/als_extension.py" = ["ARG002", "N802", "N803", "N815"]
"replay/data/nn/sequence_tokenizer.py" = ["ARG003"]
"replay/splitters/base_splitter.py" = ["ARG003"]
"replay/data/nn/sequential_dataset.py" = ["ARG003"]

[tool.tomlsort]
ignore_case = true
in_place = true
no_comments = true
spaces_indent_inline_array = 4
trailing_comma_inline_array = true

[tool.uv.build-backend]
module-name = ["replay"]
module-root = ""
source-exclude = [
    "replay/conftest.py",
{% if project == "default" %}
    "replay/experimental",
{% endif %}
]
wheel-exclude = [
    "replay/conftest.py",
{% if project == "default" %}
    "replay/experimental",
{% endif %}
]

[[tool.uv.index]]
name = "pypi"
url = "https://pypi.org/simple"
default = true

[[tool.uv.index]]
name = "torch-cpu-mirror"
url = "https://download.pytorch.org/whl/cpu"
explicit = true

[tool.uv.sources]
lightfm = { git = "https://github.com/daviddavo/lightfm.git", rev = "f0eb500ead54ab65eb8e1b3890337a7223a35114" }
{% if project == "default" %}
torch = [
    { index = "torch-cpu-mirror", marker = "extra == 'torch-cpu'" },
    { index = "pypi", marker = "extra == 'torch' and extra != 'torch-cpu'" },
]
{% endif %}
